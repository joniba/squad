{
  "tasks": [
    {
      "name": "teams-watchdog",
      "script": ".squad/skills/teams-watchdog/run-pipeline.ps1",
      "interval": "24h",
      "enabled": true,
      "condition": null
    },
    {
      "name": "icm-scan",
      "type": "agent",
      "agent": "aragorn",
      "prompt": "Scan IcM team 116041 for active incidents. Filter for: Sev2, Sev3 recommended for bump, and CRIs (Incident Type == System/Customer Reported). Report findings with ICM ID, severity, title, type, and created date.",
      "interval": "4h",
      "enabled": false,
      "condition": "oncall"
    },
    {
      "name": "daily-summary",
      "script": "scripts/squad-daily-summary.ps1",
      "interval": "24h",
      "enabled": true,
      "condition": null
    },
    {
      "name": "semantic-refresh",
      "script": "scripts/semantic-index.ps1",
      "interval": "12h",
      "enabled": true,
      "condition": null
    },
    {
      "name": "email-watchdog",
      "script": ".squad/skills/email-watchdog/email-scan.ps1",
      "interval": "24h",
      "enabled": true,
      "condition": null,
      "params": {
        "Hours": 24,
        "TeamWebhook": "env:EMAIL_WATCHDOG_WEBHOOK"
      }
    }
  ],
  "oncall": {
    "enabled": false,
    "team_id": 116041,
    "check_alias": "jbenami"
  },
  "log_file": ".squad/scheduler.log"
}
