<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>DgrepCli</RootNamespace>
    <AssemblyName>dgrep</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>Geneva DGrep CLI — query unindexed logs from the command line</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLI argument parsing -->
    <PackageReference Include="CommandLineParser" Version="2.9.*" />
    <!-- JSON serialization -->
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
  </ItemGroup>

  <!-- Phase 2: Uncomment when ready for SDK integration
  <ItemGroup>
    <PackageReference Include="Microsoft.Geneva.DGrep.SDK" Version="*" />
  </ItemGroup>
  -->

</Project>
